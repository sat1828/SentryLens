# ═══════════════════════════════════════════════════════════════════
# SentryLens — Environment Configuration
# Copy to .env and fill in all values. Never commit .env to git.
# ═══════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────
APP_NAME=SentryLens
APP_ENV=development   # development | production | test

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In production, must be ≥32 chars and not the default value below — server refuses to start.
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_MINIMUM_32_CHARACTERS_HERE

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Set to false in production: only admins can create new user accounts.
# True means anyone can self-register — only acceptable behind a VPN/firewall.
REGISTRATION_OPEN=true

# Full public URL of your dashboard — embedded in SMS alert "View:" links.
# In production set to your real domain e.g. https://sentrylens.yourcompany.com
DASHBOARD_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────
# These are overridden by docker-compose environment: section in dev.
DATABASE_URL=postgresql+asyncpg://sentrylens:sentrylens_dev_pass@postgres:5432/sentrylens
DATABASE_URL_SYNC=postgresql://sentrylens:sentrylens_dev_pass@postgres:5432/sentrylens

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Twilio SMS alerts ──────────────────────────────────────────────
# Get from twilio.com/console — free trial available, no credit card needed.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1415XXXXXXX

# Comma-separated phone numbers that receive violation SMS alerts (E.164 format).
# On Twilio free trial, these numbers must be verified at console.twilio.com/verified-numbers.
DEFAULT_ALERT_RECIPIENTS=+919XXXXXXXXXX

# ── YOLOv8 model ──────────────────────────────────────────────────
# Path to trained model inside the container (mount via model_data volume).
# Without this file, system falls back to yolov8m.pt (COCO weights — PPE NOT detected).
# Run ml/training/train.py to generate this file. See DEPLOYMENT.md.
MODEL_PATH=/app/models/sentrylens_best.pt
FALLBACK_MODEL=yolov8m.pt

# Inference settings
INFERENCE_CONFIDENCE=0.65            # Minimum box confidence to report a detection
NMS_IOU_THRESHOLD=0.45
INFERENCE_EVERY_N_FRAMES=3           # Run inference every Nth frame (3 = ~10fps from 30fps source)

# ── Violation thresholds ──────────────────────────────────────────
# Minimum confidence to LOG a violation and fire an SMS alert.
# Higher = fewer false positives but may miss real violations.
# Start at 0.70, tune per camera after 48h of observation.
VIOLATION_CONFIDENCE_THRESHOLD=0.70

# Min gap between SMS alerts for the same camera + violation type (seconds).
# 30s prevents spam on persistent violations. Increase if SMS costs are a concern.
ALERT_COOLDOWN_SECONDS=30

# Persons inside a scaffold zone before overcrowding alert fires.
SCAFFOLD_OVERCROWD_THRESHOLD=6

# ── Storage ────────────────────────────────────────────────────────
# Frame snapshot directory inside the container.
SNAPSHOT_DIR=/app/snapshots

# Delete snapshots older than this many days to manage disk.
MAX_SNAPSHOT_AGE_DAYS=90

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
